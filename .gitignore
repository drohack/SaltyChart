*.db*
backend/dev.db
backend/prisma/**/*.db*

# SvelteKit build & intermediate artefacts
/.svelte-kit/
/build/
legacy/
# Remove old prototype artefacts (kept out of the way)
/src/
/svelte.config.js
/vite.config.js
/tailwind.config.cjs
/postcss.config.cjs
/tsconfig.json

# Production/platform specific build folders (optional)
/.vercel/
/.netlify/

# Coverage directories
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files - keep secrets out of source control
.env
.env.*.local
.env.local

# IDE/editor settings
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# TypeScript incremental build files
*.tsbuildinfo

# Docker override file (optional, often local-only)
docker-compose.override.yml

# Build archives
*.tar

# Claude Code internal directory. Settings hold machine-specific paths and
# permission grants, so they stay out - but skills and rules are contributor
# guidance that belongs in the repo, same as CLAUDE.md. Without these
# exceptions, moving a section out of CLAUDE.md into a skill or a path-scoped
# rule would delete it from the repository. That is not hypothetical twice
# over: both mechanisms were adopted here to shrink CLAUDE.md, and the second
# one was caught only because `git check-ignore` was run before writing the
# file. `test_audit_anchors.py` now asserts no rule file is ignored.
#
# Note the `/*` rather than `/`: git cannot re-include anything inside an
# excluded DIRECTORY, so excluding the contents is what makes the negation work.
.claude/*
!.claude/skills/
!.claude/rules/

# Build output. Both are regenerated by `npm run build`, and the Docker images
# compile from source in a builder stage rather than shipping a committed copy -
# the backend's was tracked for a while, went a year without a rebuild, and was
# missing whole routers by the end.
frontend/dist/
backend/dist/

# Playwright MCP test artifacts (screenshots + page/console logs)
/compare-*.png
/randomize-*.png
/home-*.png
.playwright-mcp/

# Python bytecode cache
__pycache__/
*.pyc

# Whisper benchmark data (audio clips + CC text, ~10MB, not needed in repo)
tools/benchmark_data/

# Match-replay fixtures: a snapshot of the real Jellyfin library, including
# every title and its internal item ids. This repo is public, so committing it
# would publish an inventory of the media server. Build them locally instead:
#   py -3.13 -u tools/tests/build_match_fixtures.py
tools/tests/fixtures/
