# Copy to `.env` and tweak as needed.
ANILIST_API_URL=https://graphql.anilist.co

# Required: secret used to sign/verify auth tokens. docker-compose reads this
# from the adjacent .env (never commit the real value). Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# (Optional) OAuth details if you want to let users login with their AniList account.
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=
