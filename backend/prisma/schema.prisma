// Prisma schema for SaltyChart.
// NOTE: production does NOT run `prisma migrate`. The raw SQL in
// ensureDatabaseSchema() (backend/src/index.ts) is authoritative at runtime -
// it creates/patches every table (incl. SeasonCache & SubtitleCache) on
// startup. Keep this schema in sync with that SQL; run `npx prisma generate`
// (not `migrate`) after edits so the client types match.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // hashed with bcrypt
  createdAt DateTime @default(now())

  /// Recovery address. Deliberately NOT unique - a household may share one, and
  /// nothing ever looks a user up by it (reset is keyed on username).
  email           String?
  /// Non-null is the entire protection rule: an account with a *verified*
  /// address can only be reset through an emailed code. An unverified address
  /// must never count, or a typo makes the account permanently unresettable.
  emailVerifiedAt DateTime?
  /// Replaces the `ADMIN_USER_ID` env comparison. Admins are symmetric peers;
  /// the only invariant is that demote/delete never leave zero of them.
  isAdmin         Boolean   @default(false)
  /// Bumped on every password change so live JWTs stop working. A token with no
  /// `v` claim reads as 0 - this default - which is what keeps the hand-minted
  /// admin tokens in `tools/` valid.
  tokenVersion    Int       @default(0)

  lists     WatchList[]
  /// Optional one-to-one link to user settings
  settings  Settings?
}

model WatchList {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  season    String
  year      Int
  mediaId   Int
  order     Int
  customName String?
  createdAt DateTime @default(now())

  /// Whether the user has marked this series as watched.
  watched Boolean @default(false)

  /// Timestamp when user marked series as watched (null = not watched yet)
  watchedAt DateTime?

  /// Optional ranking index set when watched=true.  Lower numbers appear at
  /// the top of the Watched ranking UI.  Null means no manual ranking (falls
  /// back to watchedAt ordering).
  watchedRank Int?
  hidden      Boolean @default(false)

  @@unique([userId, season, year, mediaId])
  // Speeds up queries that filter by userId alone (e.g. /api/list?season=...)
  // and by season/year (e.g. /users-with-ratings).
  @@index([userId])
  @@index([season, year])
}

/// User-specific display & UI preferences
model Settings {
  /// FK to User.id, also PK
  userId          Int     @id
  /// Theme preference: LIGHT, NIGHT, SYSTEM, HIGH_CONTRAST
  theme           String  @default("SYSTEM")
  /// Title language preference: ENGLISH, ROMAJI, NATIVE
  titleLanguage   String  @default("ENGLISH")
  /// Whether to autoplay videos
  videoAutoplay   Boolean @default(true)
  /// Whether to hide user from compare nav
  hideFromCompare Boolean @default(false)
  /// Where to add newly watched items: TOP or BOTTOM
  addWatchedTo    String  @default("BOTTOM")
  /// JSON array: which users' custom nicknames to surface in pop-ups (raw-SQL column)
  nicknameUserSel String?
  /// JSON: per-video subtitle on/off preferences (raw-SQL column)
  subtitlePrefs   String?

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // /api/users filters by hideFromCompare on every request; index turns a
  // table scan into an index lookup.
  @@index([hideFromCompare])
}

/// Short-lived one-time codes for password reset and email verification.
///
/// **Deliberately carries no Prisma relation to User.** A relation would invite
/// a cascade, and SQLite cannot alter a foreign key in place - adding one later
/// means rebuilding a live table. Deleting a user clears these rows explicitly
/// instead, in the same transaction as the lists and settings.
model AuthCode {
  id         Int       @id @default(autoincrement())
  userId     Int
  /// 'reset' | 'verifyEmail'
  purpose    String
  /// bcrypt, NOT a fast digest. Six digits is only a million values, so a fast
  /// hash would make a leaked database equivalent to a leaked code.
  codeHash   String
  expiresAt  DateTime
  /// Wrong guesses. At the cap the code is consumed, so guessing costs a fresh
  /// request per N attempts rather than a fresh guess.
  attempts   Int       @default(0)
  /// Non-null once used, superseded, or killed by the attempt cap.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
}

/// AniList season-listing cache. Created & maintained by the raw SQL in
/// ensureDatabaseSchema() (index.ts); mirrored here so `prisma migrate` doesn't
/// see it as drift and so the generated client is typed for it.
model SeasonCache {
  season    String
  year      Int
  format    String
  data      String
  updatedAt DateTime

  @@id([season, year, format])
}

/// Server-wide key/value config: the Jellyfin URL + API key set via the admin
/// page, and the cached AniList->TVDB id map. Created & maintained by the raw
/// SQL in ensureDatabaseSchema() (index.ts); mirrored here (same reason as
/// SeasonCache).
model AppConfig {
  key   String @id
  value String
}

/// Our own AniList -> TVDB/TMDB overrides - an override *layer* over the
/// community map, not a copy of it. Rows exist only for corrections,
/// confirmations of title-only matches, and entries the map never covered.
/// Created & maintained by the raw SQL in ensureDatabaseSchema() (index.ts);
/// mirrored here so `prisma generate` types the client (same reason as
/// SeasonCache). `source`: manual (a human) | remote (our own lookup).
model SeriesIdentity {
  anilistId Int      @id
  tvdbId    String?
  tmdbId    String?
  tmdbKind  String?
  source    String   @default("manual")
  confirmed Boolean  @default(false)
  /// "this entry is definitively NOT in the library" - suppresses the title
  /// fallback as well as the map. Distinct from `confirmed` with blank ids,
  /// which is what confirming a good title match looks like.
  rejected  Boolean  @default(false)
  /// The ids on this row are a *suggestion* from the remote resolver that could
  /// not be verified against an air date. They ARE used - a resolver id is
  /// positive-only, so it can add a Watch button and never remove one - but the
  /// match is marked unverified in the UI and listed on /admin/matching.
  pending      Boolean @default(false)
  /// Which resolver decided this row (RESOLVER_VERSION in seriesIdentity.ts).
  /// Rows below the current version are re-resolved by regradeStoredRows, which
  /// is how a ladder or ranking change reaches rows already stored - the main
  /// sweep skips any entry that already carries an id. Null on rows written
  /// before the stamp existed.
  resolverVersion Int?
  /// The title the resolver matched against, so a reviewer can judge the
  /// suggestion without repeating the search.
  matchedTitle String?
  /// JSON array of the lookup's top candidates (five - TMDB orders by
  /// relevance and the tail is noise; see `searchOne`), best-first, so the
  /// review page can offer alternatives rather than a yes/no on the first hit.
  candidates   String?
  /// Release year from the source that named the identity. Display only.
  year      Int?
  note      String?
  updatedAt DateTime @default(now())
}

/// Force-include overlay for the Sonarr Custom List: "propose this even though
/// a filter dropped it". The ONLY direction of override this feature has -
/// "never add this" is Sonarr's own Import List Exclusion, which is global and
/// authoritative, so duplicating it here would be two records of one intent.
/// Small by construction, like SeriesIdentity. Created by the raw SQL in
/// `index.ts`; production never runs `prisma migrate`.
model SonarrInclude {
  anilistId Int      @id
  /// Denormalised so the entry is still a candidate if identity resolution is
  /// briefly unavailable - a force-include is a human decision and should not
  /// evaporate because a map has not loaded.
  tvdbId    Int
  /// Someone was shown that this entry's identity is unverified and included it
  /// anyway. Required before a pending or rejected identity becomes a candidate:
  /// an override may outrank the filter, but only as an informed decision. See
  /// the force-include branch in `lib/sonarrSelect.ts` for the hole this closed.
  acknowledgedUnverified Boolean @default(false)
  note      String?
  addedBy   String?
  createdAt DateTime @default(now())
}

/// What we have added to Sonarr - and the record that stops us adding it twice.
///
/// A row with status `pushed` or `alreadyHeld` is **terminal**: that tvdbId is
/// never considered again, so a series deleted afterwards stays deleted.
/// `lookupFailed` and `failed` are retryable, because in both cases nothing was
/// added. State machine in `lib/sonarrPush.ts`; created by the raw SQL in
/// `index.ts`.
model SonarrPush {
  /// The identity, and the reason a corrected match pushes fresh: a different
  /// series gets a different id, so it has no terminal row of its own.
  tvdbId         Int       @id
  /// The AniList entry this was added *for*. Makes an orphan visible when that
  /// entry is later re-identified to a different tvdbId.
  anilistId      Int?
  title          String    @default("")
  /// 'pushed' | 'alreadyHeld' | 'lookupFailed' | 'failed'
  status         String
  /// Sonarr's own series id, so a human can find the row it created.
  sonarrSeriesId Int?
  pushedAt       DateTime?
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  lastError      String?
}

/// Per-YouTube-video subtitle cache: check results, translated segments, and
/// user subtitle preferences. Created & maintained by the raw SQL in
/// ensureDatabaseSchema() (index.ts); mirrored here (same reason as SeasonCache).
model SubtitleCache {
  id                Int       @id @default(autoincrement())
  videoId           String    @unique
  mediaId           Int?
  modelName         String    @default("small")
  hasEnglishSubs    Boolean?
  hasBurnedInSubs   Boolean?
  segments          String?
  createdAt         DateTime  @default(now())
  subtitlesDisabled Boolean?  @default(false)
  lastEnCheckAt     DateTime?
}
