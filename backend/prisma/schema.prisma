// Prisma schema for SaltyChart.
// NOTE: production does NOT run `prisma migrate`. The raw SQL in
// ensureDatabaseSchema() (backend/src/index.ts) is authoritative at runtime —
// it creates/patches every table (incl. SeasonCache & SubtitleCache) on
// startup. Keep this schema in sync with that SQL; run `npx prisma generate`
// (not `migrate`) after edits so the client types match.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // hashed with bcrypt
  createdAt DateTime @default(now())

  lists     WatchList[]
  /// Optional one-to-one link to user settings
  settings  Settings?
}

model WatchList {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  season    String
  year      Int
  mediaId   Int
  order     Int
  customName String?
  createdAt DateTime @default(now())

  /// Whether the user has marked this series as watched.
  watched Boolean @default(false)

  /// Timestamp when user marked series as watched (null = not watched yet)
  watchedAt DateTime?

  /// Optional ranking index set when watched=true.  Lower numbers appear at
  /// the top of the Watched ranking UI.  Null means no manual ranking (falls
  /// back to watchedAt ordering).
  watchedRank Int?
  hidden      Boolean @default(false)

  @@unique([userId, season, year, mediaId])
  // Speeds up queries that filter by userId alone (e.g. /api/list?season=...)
  // and by season/year (e.g. /users-with-ratings).
  @@index([userId])
  @@index([season, year])
}

/// User-specific display & UI preferences
model Settings {
  /// FK to User.id, also PK
  userId          Int     @id
  /// Theme preference: LIGHT, NIGHT, SYSTEM, HIGH_CONTRAST
  theme           String  @default("SYSTEM")
  /// Title language preference: ENGLISH, ROMAJI, NATIVE
  titleLanguage   String  @default("ENGLISH")
  /// Whether to autoplay videos
  videoAutoplay   Boolean @default(true)
  /// Whether to hide user from compare nav
  hideFromCompare Boolean @default(false)
  /// Where to add newly watched items: TOP or BOTTOM
  addWatchedTo    String  @default("BOTTOM")
  /// JSON array: which users' custom nicknames to surface in pop-ups (raw-SQL column)
  nicknameUserSel String?
  /// JSON: per-video subtitle on/off preferences (raw-SQL column)
  subtitlePrefs   String?

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // /api/users filters by hideFromCompare on every request; index turns a
  // table scan into an index lookup.
  @@index([hideFromCompare])
}

/// AniList season-listing cache. Created & maintained by the raw SQL in
/// ensureDatabaseSchema() (index.ts); mirrored here so `prisma migrate` doesn't
/// see it as drift and so the generated client is typed for it.
model SeasonCache {
  season    String
  year      Int
  format    String
  data      String
  updatedAt DateTime

  @@id([season, year, format])
}

/// Server-wide key/value config: the Jellyfin URL + API key set via the admin
/// page, and the cached AniList→TVDB id map. Created & maintained by the raw
/// SQL in ensureDatabaseSchema() (index.ts); mirrored here (same reason as
/// SeasonCache).
model AppConfig {
  key   String @id
  value String
}

/// Our own AniList → TVDB/TMDB overrides — an override *layer* over the
/// community map, not a copy of it. Rows exist only for corrections,
/// confirmations of title-only matches, and entries the map never covered.
/// Created & maintained by the raw SQL in ensureDatabaseSchema() (index.ts);
/// mirrored here so `prisma generate` types the client (same reason as
/// SeasonCache). `source`: manual (a human) | remote (our own lookup).
model SeriesIdentity {
  anilistId Int      @id
  tvdbId    String?
  tmdbId    String?
  tmdbKind  String?
  source    String   @default("manual")
  confirmed Boolean  @default(false)
  /// "this entry is definitively NOT in the library" — suppresses the title
  /// fallback as well as the map. Distinct from `confirmed` with blank ids,
  /// which is what confirming a good title match looks like.
  rejected  Boolean  @default(false)
  /// The ids on this row are a *suggestion* from the remote resolver that could
  /// not be verified against an air date. They ARE used — a resolver id is
  /// positive-only, so it can add a Watch button and never remove one — but the
  /// match is marked unverified in the UI and listed on /admin/matching.
  pending      Boolean @default(false)
  /// Which resolver decided this row (RESOLVER_VERSION in seriesIdentity.ts).
  /// Rows below the current version are re-resolved by regradeStoredRows, which
  /// is how a ladder or ranking change reaches rows already stored — the main
  /// sweep skips any entry that already carries an id. Null on rows written
  /// before the stamp existed.
  resolverVersion Int?
  /// The title the resolver matched against, so a reviewer can judge the
  /// suggestion without repeating the search.
  matchedTitle String?
  /// JSON array of the lookup's top candidates (five — TMDB orders by
  /// relevance and the tail is noise; see `searchOne`), best-first, so the
  /// review page can offer alternatives rather than a yes/no on the first hit.
  candidates   String?
  /// Release year from the source that named the identity. Display only.
  year      Int?
  note      String?
  updatedAt DateTime @default(now())
}

/// Per-YouTube-video subtitle cache: check results, translated segments, and
/// user subtitle preferences. Created & maintained by the raw SQL in
/// ensureDatabaseSchema() (index.ts); mirrored here (same reason as SeasonCache).
model SubtitleCache {
  id                Int       @id @default(autoincrement())
  videoId           String    @unique
  mediaId           Int?
  modelName         String    @default("small")
  hasEnglishSubs    Boolean?
  hasBurnedInSubs   Boolean?
  segments          String?
  createdAt         DateTime  @default(now())
  subtitlesDisabled Boolean?  @default(false)
  lastEnCheckAt     DateTime?
}
