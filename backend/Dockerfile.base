################  Backend base image ################
#
# Everything heavy and slow-changing lives here: system packages, Python
# translation deps, and the pre-downloaded Whisper models (~3.3 GB total).
# The app image (Dockerfile) builds FROM a *pinned* tag of this image, so
# routine deploys never re-transfer these layers.
#
# This image is built ONLY by the manually-dispatched `build-base` GitHub
# Actions workflow (or locally for testing):
#
#   docker build -f Dockerfile.base -t ghcr.io/drohack/saltychart-backend-base:v1 .
#
# To change anything here: edit, dispatch `build-base` with the next version
# (v2, v3, …), then bump the FROM line in Dockerfile to match.

FROM node:20-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     curl openssl libssl-dev \
     python3 python3-pip python3-venv \
     ffmpeg \
  && rm -rf /var/lib/apt/lists/*

# Python dependencies for real-time subtitle translation
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    faster-whisper yt-dlp youtube-transcript-api

# Pre-download Whisper models so first use doesn't wait for a download.
# small: used by the on-demand daemon for live translation (~500MB)
# medium: used by batch pre-translation for higher quality (~1.5GB)
RUN python3 -c "from faster_whisper import WhisperModel; WhisperModel('small', device='cpu', compute_type='int8'); WhisperModel('medium', device='cpu', compute_type='int8')"
